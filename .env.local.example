# Supabase Configuration (Required for Google Auth, Database & Screenshot Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Comma-separated admin emails that automatically get admin access
# (You can also promote any user via SQL: UPDATE public.profiles SET role = 'admin' WHERE email = 'you@gmail.com';)
ADMIN_EMAILS=kushal@example.com,admin@zenithiist.org

# Optional: Service Role Key (only needed if you want server-side admin auto-promotion or elevated admin queries)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment UPI Configuration (shown as a scannable QR code on the registration payment step)
NEXT_PUBLIC_UPI_ID=zenith.iist@sbi
NEXT_PUBLIC_UPI_NAME=ZENITH IIST SPORTS FEST
NEXT_PUBLIC_PAYMENT_NOTE=Pay via any UPI app (GPay, PhonePe, Paytm, BHIM) and upload the payment screenshot below.
